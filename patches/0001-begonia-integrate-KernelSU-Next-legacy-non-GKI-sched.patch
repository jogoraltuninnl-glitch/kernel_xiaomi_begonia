diff --git a/kernel/sched/cpufreq_schedutil.c b/kernel/sched/cpufreq_schedutil.c
index 79d752f8c..c109a4046 100644
--- a/kernel/sched/cpufreq_schedutil.c
+++ b/kernel/sched/cpufreq_schedutil.c
@@ -30,6 +30,30 @@ EXPORT_SYMBOL(cpufreq_notifier_fp);
 
 #define SUGOV_KTHREAD_PRIORITY	50
 
+/*
+ * ------------------------------------------------------------------
+ * BEGONIA TUNING (Redmi Note 8 Pro / MT6785 Helio G90T)
+ *
+ * Hardcoded schedutil rate limits, applied at sugov_init() instead of
+ * the generic cpufreq_policy_transition_delay_us() value (which on
+ * mt6785 resolves to a rather lazy transition latency * LATENCY_MULTIPLIER).
+ *
+ * Cluster layout on begonia:
+ *   policy0 -> cpu0..cpu5  : Cortex-A55 (LITTLE)
+ *   policy6 -> cpu6..cpu7  : Cortex-A76  (BIG)
+ *
+ * Fast ramp-up (low up_rate_limit) => better UI responsiveness.
+ * Slower ramp-down (higher down_rate_limit) => avoids frequency
+ * ping-pong / jank right after a burst of work.
+ * ------------------------------------------------------------------
+ */
+#define BEGONIA_SUGOV_BIG_CLUSTER_FIRST_CPU	6
+
+#define BEGONIA_SUGOV_UP_RATE_LIMIT_LITTLE_US	500
+#define BEGONIA_SUGOV_DOWN_RATE_LIMIT_LITTLE_US	2000
+#define BEGONIA_SUGOV_UP_RATE_LIMIT_BIG_US	250
+#define BEGONIA_SUGOV_DOWN_RATE_LIMIT_BIG_US	4000
+
 struct sugov_tunables {
 	struct gov_attr_set attr_set;
 	unsigned int up_rate_limit_us;
@@ -816,8 +840,18 @@ static int sugov_init(struct cpufreq_policy *policy)
 		goto stop_kthread;
 	}
 
-	tunables->up_rate_limit_us = cpufreq_policy_transition_delay_us(policy);
-	tunables->down_rate_limit_us = cpufreq_policy_transition_delay_us(policy);
+	/* BEGONIA TUNING: hardcoded, cluster-aware rate limits. */
+	if (policy->cpu >= BEGONIA_SUGOV_BIG_CLUSTER_FIRST_CPU) {
+		tunables->up_rate_limit_us = BEGONIA_SUGOV_UP_RATE_LIMIT_BIG_US;
+		tunables->down_rate_limit_us = BEGONIA_SUGOV_DOWN_RATE_LIMIT_BIG_US;
+	} else {
+		tunables->up_rate_limit_us = BEGONIA_SUGOV_UP_RATE_LIMIT_LITTLE_US;
+		tunables->down_rate_limit_us = BEGONIA_SUGOV_DOWN_RATE_LIMIT_LITTLE_US;
+	}
+
+	pr_info("begonia: schedutil policy%u up=%uus down=%uus\n",
+		policy->cpu, tunables->up_rate_limit_us,
+		tunables->down_rate_limit_us);
 
 	policy->governor_data = sg_policy;
 	sg_policy->tunables = tunables;
