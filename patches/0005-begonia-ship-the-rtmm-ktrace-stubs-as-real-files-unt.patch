From a297403f3b006faba8a1386ffa8c6b8556b77a2d Mon Sep 17 00:00:00 2001
From: egor <egor@localhost>
Date: Wed, 2 Sep 2026 02:56:17 +0000
Subject: [PATCH] begonia: ship the rtmm/ktrace stubs as real files, untrack
 drivers/kernelsu

mm/vmscan.c and the MediaTek tracing glue include <linux/rtmm.h> and
<linux/ktrace.h>, which the Xiaomi source drop never contains. They were
stubbed locally with symlinks into include/dum/, but git recorded the
symlink *targets as absolute paths*, so the series only ever worked on the
machine that produced it. On a clean checkout the build died with

  ../mm/vmscan.c:59:10: fatal error: 'linux/rtmm.h' file not found

The stubs are now ordinary headers. drivers/kernelsu was likewise committed
as an absolute symlink; it is recreated by KernelSU's setup.sh, so it is
untracked instead.
---
 drivers/kernelsu       |  1 -
 include/linux/ktrace.h |  5 ++++-
 include/linux/rtmm.h   | 27 ++++++++++++++++++++++++++-
 3 files changed, 30 insertions(+), 3 deletions(-)
 delete mode 120000 drivers/kernelsu
 mode change 120000 => 100644 include/linux/ktrace.h
 mode change 120000 => 100644 include/linux/rtmm.h

diff --git a/drivers/kernelsu b/drivers/kernelsu
deleted file mode 120000
index b32a3654a..000000000
--- a/drivers/kernelsu
+++ /dev/null
@@ -1 +0,0 @@
-../KernelSU-Next/kernel
\ No newline at end of file
diff --git a/include/linux/ktrace.h b/include/linux/ktrace.h
deleted file mode 120000
index 986387c7b..000000000
--- a/include/linux/ktrace.h
+++ /dev/null
@@ -1 +0,0 @@
-/home/user/begonia_kernel_workspace/begonia-kernel/include/dum/ktrace.h
\ No newline at end of file
diff --git a/include/linux/ktrace.h b/include/linux/ktrace.h
new file mode 100644
index 000000000..aefb67a2a
--- /dev/null
+++ b/include/linux/ktrace.h
@@ -0,0 +1,4 @@
+#ifndef __KTRACE_H__
+#define __KTRACE_H__
+
+#endif
diff --git a/include/linux/rtmm.h b/include/linux/rtmm.h
deleted file mode 120000
index 7da23e2b0..000000000
--- a/include/linux/rtmm.h
+++ /dev/null
@@ -1 +0,0 @@
-/home/user/begonia_kernel_workspace/begonia-kernel/include/dum/rtmm.h
\ No newline at end of file
diff --git a/include/linux/rtmm.h b/include/linux/rtmm.h
new file mode 100644
index 000000000..36b05698c
--- /dev/null
+++ b/include/linux/rtmm.h
@@ -0,0 +1,26 @@
+#ifndef __RTMM_H__
+#define __RTMM_H__
+
+enum {
+	RTMM_POOL_THREADINFO = 0,
+	RTMM_POOL_PGD,
+	RTMM_POOL_KMALLOC_ORDER2,
+	RTMM_POOL_NR
+};
+
+#define KMALLOC_POOL_ORDER2 2
+static inline bool rtmm_pool(const char *name)
+{
+	return false;
+}
+
+static inline bool rtmm_reclaim(const char *name)
+{
+	return false;
+}
+
+static inline int rtmm_reclaim_swappiness(void)
+{
+	return 60;
+}
+#endif
-- 
2.53.0

